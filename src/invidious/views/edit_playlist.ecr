<% title = HTML.escape(playlist.title) %>

<% content_for "header" do %>
<title><%= title %> - Invidious</title>
<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/playlist/<%= plid %>" />
<% end %>

<h1 class="page-title"><%= I18n.translate(locale, "Editing playlist `x`", %|"#{title}"|) %></h1>

<form class="edit-playlist" action="/edit_playlist?list=<%= plid %>" method="post">
    <div class="page-controls playlist-header">
        <div class="playlist-title-field">
            <input maxlength="150" name="title" type="text" value="<%= title %>" aria-label="<%= I18n.translate(locale, "Title") %>">
        </div>

        <div class="button-container">
            <a class="pure-button pure-button-secondary low-profile" dir="auto" href="/playlist?list=<%= plid %>">
                <i class="icon ion-md-close"></i>&nbsp;<%= I18n.translate(locale, "generic_button_cancel") %>
            </a>
            <button class="pure-button pure-button-secondary low-profile" dir="auto" type="submit">
                <i class="icon ion-md-save"></i>&nbsp;<%= I18n.translate(locale, "generic_button_save") %>
            </button>
            <a class="pure-button pure-button-secondary low-profile" dir="auto" href="/delete_playlist?list=<%= plid %>">
                <i class="icon ion-md-trash"></i>&nbsp;<%= I18n.translate(locale, "generic_button_delete") %>
            </a>
        </div>
    </div>

    <div class="h-box">
        <b>
            <%= HTML.escape(playlist.author) %> |
            <%= I18n.translate_count(locale, "generic_videos_count", playlist.video_count) %> |
        </b>
        <select name="privacy" aria-label="<%= I18n.translate(locale, "Playlist privacy") %>">
        <%- {"Public", "Unlisted", "Private"}.each do |option| -%>
            <option value="<%= option %>" <% if option == playlist.privacy.to_s %>selected<% end %>><%= I18n.translate(locale, option) %></option>
        <%- end -%>
        </select>
    </div>

    <div class="h-box">
        <textarea maxlength="5000" name="description" aria-label="<%= I18n.translate(locale, "playlist_description_label") %>"><%= playlist.description %></textarea>
    </div>
    <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
</form>

<div class="h-box">
    <hr>
</div>


<%= rendered "components/items_paginated" %>
