<% content_for "header" do %>
<title><%= I18n.translate(locale, "Playlists") %> - Invidious</title>
<% end %>

<%= rendered "components/feed_menu" %>

<h1 class="page-title page-title-small"><%= I18n.translate(locale, "Playlists") %></h1>

<ul class="page-controls page-links">
    <li>
        <a href="/create_playlist?referer=<%= URI.encode_www_form("/feed/playlists") %>"><%= I18n.translate(locale, "Create playlist") %></a>
    </li>
    <li>
        <a href="/data_control?referer=<%= URI.encode_www_form("/feed/playlists") %>">
            <%= I18n.translate(locale, "Import/export") %>
        </a>
    </li>
</ul>

<% env.set "item_heading", "h3" %>

<div class="h-box">
    <h2 class="group-title"><%= I18n.translate(locale, "user_created_playlists", %(<span id="count">#{items_created.size}</span>)) %></h2>
</div>

<div class="item-grid">
<% items_created.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<div class="h-box">
    <h2 class="group-title"><%= I18n.translate(locale, "user_saved_playlists", %(<span id="count">#{items_saved.size}</span>)) %></h2>
</div>

<div class="item-grid">
<% items_saved.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<script src="/js/watched_indicator.js"></script>
