<% content_for "header" do %>
<title><%= HTML.escape(mix.title) %> - Invidious</title>
<% end %>

<div class="page-controls playlist-header">
    <h1 class="page-title"><%= HTML.escape(mix.title) %></h1>
    <a href="/feed/playlist/<%= mix.id %>" aria-label="<%= I18n.translate(locale, "generic_button_rss") %>"><i class="icon ion-logo-rss"></i></a>
</div>

<div class="item-grid">
<% mix.videos.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>
