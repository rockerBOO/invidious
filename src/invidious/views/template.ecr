<%
  preferences = env.get("preferences").as(Preferences)
  locale = preferences.locale
  dark_mode = preferences.dark_mode
  theme_scheme = Invidious::User::Converters.theme_scheme(dark_mode)
  named_theme = Invidious::User::Converters::THEMES.has_key?(dark_mode)
%>
<!DOCTYPE html>
<html lang="<%= locale %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= yield_content "header" %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%= ASSET_COMMIT %>">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=<%= ASSET_COMMIT %>">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=<%= ASSET_COMMIT %>">
    <link rel="manifest" href="/site.webmanifest?v=<%= ASSET_COMMIT %>">
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=<%= ASSET_COMMIT %>" color="#575757">
    <meta name="msapplication-TileColor" content="#575757">
    <meta name="theme-color" content="#575757">
    <link title="Invidious" type="application/opensearchdescription+xml" rel="search" href="/opensearch.xml">
    <link rel="stylesheet" href="/css/pure-min.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/grids-responsive-min.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/ionicons.min.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/default.css?v=<%= ASSET_COMMIT %>">
    <% if named_theme %>
        <link rel="stylesheet" href="/css/themes/<%= dark_mode %>.css?v=<%= ASSET_COMMIT %>">
    <% end %>
    <link rel="stylesheet" href="/css/carousel.css?v=<%= ASSET_COMMIT %>">
    <script src="/js/_helpers.js?v=<%= ASSET_COMMIT %>"></script>
</head>

<body class="<%= theme_scheme.blank? ? "no" : theme_scheme %>-theme<% if named_theme %> theme-<%= dark_mode %><% end %>">
    <span style="display:none" id="dark_mode_pref"><%= dark_mode %></span>
    <div class="page">
        <header class="container">
            <div class="navbar h-box">
                <% if navbar_search %>
                    <div>
                        <a href="/" class="index-link pure-menu-heading">Invidious</a>
                    </div>
                    <div class="searchbar">
                        <% autofocus = false %><%= rendered "components/search_box" %>
                    </div>
                <% end %>

                <nav class="user-nav" aria-label="<%= I18n.translate(locale, "user_menu_label") %>">
                    <ul class="user-field">
                        <% if env.get? "user" %>
                            <li>
                                <a id="toggle_theme" href="/toggle_theme?referer=<%= env.get?("current_page") %>" class="pure-menu-heading" title="<%= I18n.translate(locale, "toggle_theme") %>" aria-label="<%= I18n.translate(locale, "toggle_theme") %>">
                                    <% if theme_scheme == "dark" %>
                                        <i class="icon ion-ios-sunny"></i>
                                    <% else %>
                                        <i class="icon ion-ios-moon"></i>
                                    <% end %>
                                </a>
                            </li>
                            <li>
                                <a id="notification_ticker" title="<%= I18n.translate(locale, "Subscriptions") %>" aria-label="<%= I18n.translate(locale, "Subscriptions") %>" aria-describedby="notification_count" href="/feed/subscriptions" class="pure-menu-heading">
                                    <% notification_count = env.get("user").as(Invidious::User).notifications.size %>
                                    <% if CONFIG.enable_user_notifications && notification_count > 0 %>
                                        <span id="notification_count"><%= notification_count %></span> <i class="icon ion-ios-notifications"></i>
                                    <% else %>
                                        <i class="icon ion-ios-notifications-outline"></i>
                                    <% end %>
                                </a>
                            </li>
                            <li>
                                <a title="<%= I18n.translate(locale, "Preferences") %>" aria-label="<%= I18n.translate(locale, "Preferences") %>" href="/preferences?referer=<%= env.get?("current_page") %>" class="pure-menu-heading">
                                    <i class="icon ion-ios-cog"></i>
                                </a>
                            </li>
                            <% if env.get("preferences").as(Preferences).show_nick %>
                                <li class="user-name">
                                    <span id="user_name"><%= HTML.escape(env.get("user").as(Invidious::User).email) %></span>
                                </li>
                            <% end %>
                            <li>
                                <form action="/signout?referer=<%= env.get?("current_page") %>" method="post">
                                    <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                                    <button type="submit" class="pure-menu-heading simulated_a"><%= I18n.translate(locale, "Log out") %></button>
                                </form>
                            </li>
                        <% else %>
                            <li>
                                <a id="toggle_theme" href="/toggle_theme?referer=<%= env.get?("current_page") %>" class="pure-menu-heading" title="<%= I18n.translate(locale, "toggle_theme") %>" aria-label="<%= I18n.translate(locale, "toggle_theme") %>">
                                    <% if theme_scheme == "dark" %>
                                        <i class="icon ion-ios-sunny"></i>
                                    <% else %>
                                        <i class="icon ion-ios-moon"></i>
                                    <% end %>
                                </a>
                            </li>
                            <li>
                                <a title="<%= I18n.translate(locale, "Preferences") %>" aria-label="<%= I18n.translate(locale, "Preferences") %>" href="/preferences?referer=<%= env.get?("current_page") %>" class="pure-menu-heading">
                                    <i class="icon ion-ios-cog"></i>
                                </a>
                            </li>
                            <% if CONFIG.login_enabled %>
                                <li>
                                    <a href="/login?referer=<%= env.get?("current_page") %>" class="pure-menu-heading">
                                        <%= I18n.translate(locale, "Log in") %>
                                    </a>
                                </li>
                            <% end %>
                        <% end %>
                    </ul>
                </nav>
            </div>
        </header>

        <main id="contents" class="container">
            <% if CONFIG.banner %>
                <div class="h-box">
                    <h3><%= CONFIG.banner %></h3>
                </div>
            <% end %>

            <%= content %>
        </main>

        <footer class="container">
            <div class="footer-columns">
                <div>
                    <ul>
                        <li>
                            <i class="icon ion-logo-github"></i>
                        <% if CONFIG.modified_source_code_url %>
                            <a href="https://github.com/iv-org/invidious"><%= I18n.translate(locale, "footer_original_source_code") %></a>&nbsp;/
                            <a href="<%= CONFIG.modified_source_code_url %>"><%= I18n.translate(locale, "footer_modfied_source_code") %></a>
                        <% else %>
                            <a href="https://github.com/iv-org/invidious"><%= I18n.translate(locale, "footer_source_code") %></a>
                        <% end %>
                        </li>
                        <li>
                            <i class="icon ion-ios-paper"></i>
                            <a href="https://github.com/iv-org/documentation"><%= I18n.translate(locale, "footer_documentation") %></a>
                        </li>
                    </ul>
                </div>

                <div>
                    <ul>
                        <li>
                            <a href="https://github.com/iv-org/invidious/blob/master/LICENSE"><%= I18n.translate(locale, "Released under the AGPLv3 on Github.") %></a>
                        </li>
                        <li>
                            <i class="icon ion-logo-javascript"></i>
                            <a rel="jslicense" href="/licenses"><%= I18n.translate(locale, "View JavaScript license information.") %></a>
                        </li>
                        <li>
                            <i class="icon ion-ios-paper"></i>
                            <a href="/privacy"><%= I18n.translate(locale, "View privacy policy.") %></a>
                        </li>
                    </ul>
                </div>

                <div>
                    <ul>
                        <li>
                            <i class="icon ion-ios-wallet"></i>
                            <a href="https://invidious.io/donate/"><%= I18n.translate(locale, "footer_donate_page") %></a>
                        </li>
                        <li>
                            <%= I18n.translate(locale, "Current version: ") %>
                            <% if CONFIG.modified_source_code_url %>
                                <a href="<%= CONFIG.modified_source_code_url %>/commit/<%= CURRENT_COMMIT %>"><%= CURRENT_VERSION %>-<%= CURRENT_COMMIT %></a>
                            <% else %>
                                <a href="https://github.com/iv-org/invidious/commit/<%= CURRENT_COMMIT %>"><%= CURRENT_VERSION %>-<%= CURRENT_COMMIT %></a>
                            <% end %>
                            @ <%= CURRENT_BRANCH %>
                            <% if CURRENT_TAG != "" %>
                            (
                                <% if CONFIG.modified_source_code_url %>
                                    <a href="<%= CONFIG.modified_source_code_url %>/releases/tag/<%= CURRENT_TAG %>"><%= CURRENT_TAG %></a>
                                <% else %>
                                    <a href="https://github.com/iv-org/invidious/releases/tag/<%= CURRENT_TAG %>"><%= CURRENT_TAG %></a>
                                <% end %>
                            )
                            <% end %>
                        </li>
                    </ul>
                </div>
            </div>
            <% if CONFIG.footer %>
                <div class="h-box v-box" id="footer-info">
                    <%= CONFIG.footer %>
                </div>
            <% end %>
        </footer>
    </div>
    <script src="/js/handlers.js?v=<%= ASSET_COMMIT %>"></script>
    <script src="/js/themes.js?v=<%= ASSET_COMMIT %>"></script>
    <% if env.get? "user" %>
        <script src="/js/sse.js?v=<%= ASSET_COMMIT %>"></script>
        <script id="notification_data" type="application/json">
        <%=
        {
            "upload_text" => HTML.escape(I18n.translate(locale, "`x` uploaded a video")),
            "live_upload_text" => HTML.escape(I18n.translate(locale, "`x` is live"))
        }.to_pretty_json
        %>
        </script>
        <% if CONFIG.enable_user_notifications %>
        <script src="/js/notifications.js?v=<%= ASSET_COMMIT %>"></script>
        <% end %>
    <% end %>
</body>

</html>
