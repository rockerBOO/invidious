<% if channel.banner %>
    <div class="h-box">
        <img class="channel-banner" src="/ggpht<%= URI.parse(channel.banner.not_nil!.gsub("=w1060-", "=w1280-")).request_target %>" alt="" />
    </div>

    <div class="h-box">
        <hr>
    </div>
<% end %>

<header class="channel-header h-box">
    <div class="channel-header-bar">
        <div class="channel-profile">
            <img src="/ggpht<%= channel_profile_pic %>" alt="" />
            <hgroup class="channel-name-pronouns">
                <h1 class="channel-name"><%= author %><% if !channel.verified.nil? && channel.verified %>&nbsp;<i class="icon ion ion-md-checkmark-circle"></i><% end %></h1>
                <% if !channel.pronouns.nil? %><p class="channel-pronouns"><%= channel.pronouns %></p><% end %>
            </hgroup>
        </div>

        <div class="channel-header-buttons">
            <% sub_count_text = number_to_short_text(channel.sub_count) %>
            <%= rendered "components/subscribe_widget" %>

            <a class="button button-secondary" dir="auto" href="/feed/channel/<%= ucid %>">
                <i class="icon ion-logo-rss"></i>&nbsp;<%= I18n.translate(locale, "generic_button_rss") %>
            </a>
        </div>
    </div>

    <div id="descriptionWrapper"><p><%= channel.description_html %></p></div>

    <ul class="channel-links">
        <li><a href="<%= youtube_url %>"><%= I18n.translate(locale, "View channel on YouTube") %></a></li>
        <li><a href="<%= redirect_url %>"><%= I18n.translate(locale, "Switch Invidious Instance") %></a></li>
    </ul>
</header>

<nav class="channel-tabs page-controls" aria-label="<%= I18n.translate(locale, "channel_tabs_label") %>">
    <ul>
        <%= Invidious::Frontend::ChannelPage.generate_tabs_links(locale, channel, selected_tab) %>
    </ul>
    <% if !sort_options.empty? %>
        <ul>
            <% sort_options.each do |sort| %>
                <li>
                    <% if sort_by == sort %>
                        <b aria-current="true"><%= I18n.translate(locale, sort) %></b>
                    <% else %>
                        <a href="<%= relative_url %>?sort_by=<%= sort %>"><%= I18n.translate(locale, sort) %></a>
                    <% end %>
                </li>
            <% end %>
        </ul>
    <% end %>
</nav>
