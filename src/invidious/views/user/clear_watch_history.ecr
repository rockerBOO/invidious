<% content_for "header" do %>
<title><%= I18n.translate(locale, "Clear watch history") %> - Invidious</title>
<% end %>

<div class="h-box">
    <h1 class="page-title"><%= I18n.translate(locale, "Clear watch history") %></h1>

    <form class="form-stacked" action="/clear_watch_history?referer=<%= URI.encode_www_form(referer) %>" method="post">
        <fieldset>
            <legend><%= I18n.translate(locale, "Clear watch history?") %></legend>

            <div class="form-actions">
                <button type="submit" name="submit" value="clear_watch_history" class="button button-primary">
                    <%= I18n.translate(locale, "Yes") %>
                </button>
                <a class="button" href="<%= URI.encode_www_form(referer) %>">
                    <%= I18n.translate(locale, "No") %>
                </a>
            </div>

            <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
        </fieldset>
    </form>
</div>
