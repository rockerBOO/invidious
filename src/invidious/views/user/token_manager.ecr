<% content_for "header" do %>
<title><%= I18n.translate(locale, "Token manager") %> - Invidious</title>
<% end %>

<h1 class="page-title"><%= I18n.translate(locale, "Token manager") %></h1>

<ul class="page-controls page-links">
    <li>
        <%= I18n.translate_count(locale, "tokens_count", tokens.size, I18n::NumberFormatting::HtmlSpan) %>
    </li>
    <li>
        <a href="/preferences?referer=<%= URI.encode_www_form(referer) %>"><%= I18n.translate(locale, "Preferences") %></a>
    </li>
</ul>

<ul class="manager-list">
<% tokens.each do |token| %>
<li class="h-box manager-item">
    <div class="manager-row<% if token[:session] == sid %> deleted<% end %>">
        <p class="manager-meta">
            <code><%= token[:session] %></code>
        </p>
        <p class="manager-meta"><time datetime="<%= token[:issued].to_rfc3339 %>"><%= I18n.translate(locale, "`x` ago", recode_date(token[:issued], locale)) %></time></p>
        <form class="manager-action" data-onsubmit="return_false" action="/token_ajax?action=revoke_token&session=<%= token[:session] %>&referer=<%= env.get("current_page") %>" method="post">
            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
            <button type="submit" class="simulated_a" data-onclick="revoke_token" data-session="<%= token[:session] %>"><%= I18n.translate(locale, "revoke") %></button>
        </form>
    </div>

    <% if tokens[-1].try &.[:session]? != token[:session] %>
        <hr>
    <% end %>
</li>
<% end %>
</ul>
