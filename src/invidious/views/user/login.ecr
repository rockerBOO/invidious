<% content_for "header" do %>
<title><%= I18n.translate(locale, "Log in") %> - Invidious</title>
<% end %>

<div class="form-page h-box">
    <h1 class="page-title"><%= I18n.translate(locale, "Log in") %></h1>

    <% case account_type when %>
    <% else # "invidious" %>
        <form class="form-stacked form-boxed" action="/login?referer=<%= URI.encode_www_form(referer) %>&type=invidious" method="post">
            <% if email %>
                <input name="email" type="hidden" value="<%= HTML.escape(email) %>">
            <% else %>
                <label for="email"><%= I18n.translate(locale, "User ID") %> :</label>
                <input required name="email" id="email" type="text" autocomplete="username" placeholder="<%= I18n.translate(locale, "User ID") %>">
            <% end %>

            <% if password %>
                <input name="password" type="hidden" value="<%= HTML.escape(password) %>">
            <% else %>
                <label for="password"><%= I18n.translate(locale, "Password") %> :</label>
                <input required name="password" id="password" type="password" autocomplete="current-password" placeholder="<%= I18n.translate(locale, "Password") %>">
            <% end %>

            <% if captcha %>
                <img class="captcha-image" src='<%= captcha[:question] %>' alt="<%= I18n.translate(locale, "login_captcha_image_alt") %>">
                <% captcha[:tokens].each_with_index do |token, i| %>
                    <input type="hidden" name="token[<%= i %>]" value="<%= HTML.escape(token) %>">
                <% end %>
                <label for="answer"><%= I18n.translate(locale, "Time (h:mm:ss):") %></label>
                <input type="text" name="answer" id="answer" placeholder="h:mm:ss">

                <button type="submit" name="action" value="signin" class="pure-button pure-button-primary">
                    <%= I18n.translate(locale, "Register") %>
                </button>
            <% else %>
                <button type="submit" name="action" value="signin" class="pure-button pure-button-primary">
                    <%= I18n.translate(locale, "Sign In") %>/<%= I18n.translate(locale, "Register") %>
                </button>
            <% end %>
        </form>
    <% end %>
</div>
