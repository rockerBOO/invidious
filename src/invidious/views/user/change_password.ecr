<% content_for "header" do %>
<title><%= I18n.translate(locale, "Change password") %> - Invidious</title>
<% end %>

<div class="form-page h-box">
    <h1 class="page-title"><%= I18n.translate(locale, "Change password") %></h1>

    <form class="form-stacked form-boxed" action="/change_password?referer=<%= URI.encode_www_form(referer) %>" method="post">
        <label for="password"><%= I18n.translate(locale, "Password") %> :</label>
        <input required name="password" id="password" type="password" autocomplete="current-password" placeholder="<%= I18n.translate(locale, "Password") %>">

        <label for="new_password[0]"><%= I18n.translate(locale, "New password") %> :</label>
        <input required name="new_password[0]" id="new_password[0]" type="password" autocomplete="new-password" placeholder="<%= I18n.translate(locale, "New password") %>">

        <label for="new_password[1]"><%= I18n.translate(locale, "New password") %> :</label>
        <input required name="new_password[1]" id="new_password[1]" type="password" autocomplete="new-password" placeholder="<%= I18n.translate(locale, "New password") %>">

        <button type="submit" name="action" value="change_password" class="pure-button pure-button-primary">
            <%= I18n.translate(locale, "Change password") %>
        </button>

        <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
    </form>
</div>
