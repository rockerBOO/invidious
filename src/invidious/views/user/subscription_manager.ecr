<% content_for "header" do %>
<title><%= I18n.translate(locale, "Subscription manager") %> - Invidious</title>
<% end %>

<h1 class="page-title"><%= I18n.translate(locale, "Subscription manager") %></h1>

<ul class="page-controls page-links">
    <li>
        <a href="/feed/subscriptions">
            <%= I18n.translate_count(locale, "generic_subscriptions_count", subscriptions.size, I18n::NumberFormatting::HtmlSpan) %>
        </a>
    </li>
    <li>
        <a href="/feed/history">
            <%= I18n.translate(locale, "Watch history") %>
        </a>
    </li>
    <li>
        <a href="/data_control?referer=<%= URI.encode_www_form(referer) %>">
            <%= I18n.translate(locale, "Import/export") %>
        </a>
    </li>
</ul>

<ul class="manager-list">
<% subscriptions.each do |channel| %>
    <li class="h-box manager-item">
        <div class="manager-row<% if channel.deleted %> deleted<% end %>">
            <div class="manager-name">
                <a href="/channel/<%= channel.id %>"><%= HTML.escape(channel.author) %></a>
            </div>
            <form class="manager-action" data-onsubmit="return_false" action="/subscription_ajax?action=remove_subscriptions&c=<%= channel.id %>&referer=<%= env.get("current_page") %>" method="post">
                <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                <button type="submit" class="simulated_a" data-onclick="remove_subscription" data-ucid="<%= channel.id %>"><%= I18n.translate(locale, "unsubscribe") %></button>
            </form>
        </div>

        <% if subscriptions[-1].author != channel.author %>
            <hr>
        <% end %>
    </li>
<% end %>
</ul>
